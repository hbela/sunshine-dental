# API environment — copy to .env for local dev, or set these as secrets in
# Coolify for production. NEVER commit real values (.env is gitignored).

# Which clinic this instance serves — an id from packages/shared/src/clinics/.
# Drives the chat prompt's facts, /api/faq, the OpenAPI title and the seed's
# staff/availability. Unset = sunshine. The web bundle needs the SAME value as
# VITE_CLINIC_ID at build time.
CLINIC_ID="sunshine"

# Prisma.io production Postgres (pooled). Keep ?sslmode=require.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Public web origin(s), comma-separated. Used for CORS + better-auth trusted origins.
# Dev default is http://localhost:5173 when unset.
WEB_ORIGIN="https://your-domain.com"

# better-auth — required in production.
# Must equal the public URL the browser uses; controls Secure cookie + base path.
BETTER_AUTH_URL="https://your-domain.com"
# Stable secret for signing sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-32+chars"

# Shared key the n8n webhooks send to authenticate to the API.
FASTIFY_API_KEY="change-me"

# Anthropic API key powering the patient-facing chat receptionist (Claude Haiku 4.5).
# Get one at https://console.anthropic.com. Without it, the /api/chat endpoints
# return 503 but the rest of the app (dashboard, staff booking) is unaffected.
ANTHROPIC_API_KEY="sk-ant-..."

# n8n webhook that emails the patient a booking confirmation after a CHAT booking.
# Leave empty to disable chat confirmation emails; the booking still succeeds. e.g.
# https://n8ndev.appointer.hu/webhook/chat-booking-confirmation
N8N_BOOKING_WEBHOOK_URL=""
# Shared secret sent as the x-webhook-secret header on that webhook call; the n8n
# workflow rejects requests without it (both header auth and a fail-closed check
# inside the workflow). Must match the n8n instance's N8N_WEBHOOK_SECRET.
# Required when the URL above is set. Generate: openssl rand -hex 16
N8N_WEBHOOK_SECRET=""

# Patient-PII encryption master key — LOCAL DEV ONLY. Generate: openssl rand -hex 32
# In production DO NOT set this (or ALLOW_ENV_KEY): the server must boot locked
# and a clinic ADMIN unlocks it via POST /api/admin/unlock after every restart.
# The key never being stored on the server is the whole point of the custody model.
ENCRYPTION_KEY=""

# Port the Fastify server listens on (default 3000).
PORT="3000"

# Sentry error tracking (optional). DSN for the API's Sentry project; leave empty
# to disable — the server then boots with Sentry as a no-op. In production set it
# as a Coolify secret. Get it from your sentry.io project settings.
SENTRY_DSN=""
