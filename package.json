{
  "name": "sunshine-dental",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "guide:shots": "tsx scripts/screenshot-app.mts",
    "guide:publish": "tsx scripts/publish-user-guide.mts",
    "guide:publish:en": "tsx scripts/publish-user-guide.mts --lang en",
    "guide:publish:hu": "tsx scripts/publish-user-guide.mts --lang hu",
    "guide:publish:de": "tsx scripts/publish-user-guide.mts --lang de",
    "video": "pnpm --filter @repo/video-generator video",
    "video:scenes": "pnpm --filter @repo/video-generator video:scenes",
    "video:screens": "pnpm --filter @repo/video-generator video:screens",
    "video:voice": "pnpm --filter @repo/video-generator video:voice",
    "video:render": "pnpm --filter @repo/video-generator video:render",
    "video:studio": "pnpm --filter @repo/video-generator video:studio",
    "video:browsers": "pnpm --filter @repo/video-generator video:browsers"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "tsx": "^4.22.4",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
