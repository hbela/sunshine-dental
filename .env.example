# Portfolio (my-blog) publishing — used by scripts/publish-user-guide.mts
# Local dev: http://localhost:3000 · Prod: https://portfolio.appointer.hu
PORTFOLIO_API_URL="http://localhost:3000"
# Must equal my-blog's IMPORT_API_SECRET. Reuse the same shared value across projects.
PORTFOLIO_IMPORT_SECRET=""
# Where my-blog's public/ lives, relative to this repo root (or an absolute path).
PORTFOLIO_PUBLIC_DIR="../my-blog/public"
