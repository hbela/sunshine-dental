    {
      "parameters": {
        "jsCode": "// Format available slots response for Retell\n// Expected API response: { slots: [\"09:00\", \"09:30\"], duration: 30, provider_name: \"Dr. Smith\" }\nconst webhookData = $('Retell Webhook').first().json;\nconst date = webhookData.body.args.date;\nconst appointmentType = webhookData.body.args.appointment_type;\nconst providerName = webhookData.body.args.provider_name || null;\n\nconst apiResponse = $input.first().json;\nconst slots = apiResponse.slots || [];\nconst duration = apiResponse.duration || 30;\nconst provider = apiResponse.provider_name || providerName;\n\nconst typeDisplay = appointmentType.replace(/_/g, ' ');\nconst providerDisplay = provider ? ` with ${provider}` : '';\n\nif (slots.length === 0) {\n  return [{ json: { result: `I'm sorry, there are no available ${typeDisplay} slots on ${date}${providerDisplay}. Would you like to try a different date?` } }];\n}\n\nreturn [{ json: { result: `Available ${typeDisplay} slots on ${date}${providerDisplay}: ${slots.join(', ')}. Each appointment is ${duration} minutes. Which time would you prefer?` } }];"
      },
