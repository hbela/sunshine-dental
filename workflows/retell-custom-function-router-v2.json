    {
      "parameters": {
        "jsCode": "// Format booking confirmation response for Retell\nconst args = $('Retell Webhook').first().json.body.args;\nconst typeNames = {\n  new_patient_exam: 'New Patient Exam',\n  cleaning: 'Regular Cleaning',\n  deep_cleaning: 'Deep Cleaning',\n  filling: 'Filling',\n  crown_prep: 'Crown Prep',\n  consultation: 'Consultation',\n  emergency: 'Emergency Visit'\n};\nconst typeName = typeNames[args.appointment_type] || args.appointment_type;\n\n// Format time to 12-hour\nconst [h, m] = args.time.split(':').map(Number);\nconst ampm = h >= 12 ? 'PM' : 'AM';\nconst h12 = h > 12 ? h - 12 : (h === 0 ? 12 : h);\nconst timeFormatted = `${h12}:${m.toString().padStart(2,'0')} ${ampm}`;\n\nlet result = `Your appointment has been booked! Here are the details: ${typeName} on ${args.date} at ${timeFormatted} for ${args.patient_name}`;\nif (args.provider_name) result += ` with ${args.provider_name}`;\nresult += '.';\n\nif (args.email) {\n  result += ` A confirmation email has been sent to ${args.email}.`;\n}\n\nif (args.is_new_patient) {\n  result += ` Since you're a new patient, please arrive 15 minutes early and bring your photo ID, insurance card, and a list of current medications.`;\n}\n\nresult += ` Is there anything else I can help you with?`;\n\nreturn [{ json: { result } }];"
      },
      "id": "6623bad6-d21a-475a-8e9c-56cb995f5e66",
      "name": "Format Booking Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        256
      ]
    },
