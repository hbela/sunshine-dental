    {
      "parameters": {
        "jsCode": "const args = $('Retell Webhook').first().json.body.args;\nlet result = `The appointment for ${args.patient_name} on ${args.date} has been cancelled.`;\nif (args.reason) {\n  result += ` Reason: ${args.reason}.`;\n}\nresult += ' Would you like to reschedule or is there anything else I can help with?';\nreturn [{ json: { result } }];"
      },
      "id": "9a9dac99-9ee1-411e-85fc-e4627d29f8be",
      "name": "Format Cancel Success",
