      "parameters": {
        "sendTo": "={{ $('Retell Webhook').first().json.body.args.email }}",
        "subject": "Appointment Confirmation - Sunshine Dental Clinic",
        "message": "<h2>Appointment Confirmed!</h2><p>Dear {{ $('Retell Webhook').first().json.body.args.patient_name }},</p><p>Your appointment has been confirmed with the following details:</p><ul><li><strong>Date:</strong> {{ $('Retell Webhook').first().json.body.args.date }}</li><li><strong>Time:</strong> {{ $('Retell Webhook').first().json.body.args.time }}</li><li><strong>Type:</strong> {{ $('Retell Webhook').first().json.body.args.appointment_type.replace(/_/g, ' ') }}</li><li><strong>Doctor:</strong> {{ $('Retell Webhook').first().json.body.args.doctor_name || 'Will be confirmed' }}</li></ul>{{ $('Retell Webhook').first().json.body.args.is_new_patient ? '<p><strong>New Patient Reminder:</strong> Please arrive 15 minutes early and bring your photo ID, insurance card, and a list of current medications.</p>' : '' }}<p>If you need to cancel or reschedule, please call us at least 24 hours in advance at (555) 123-4567.</p><p>We look forward to seeing you!</p><p>Best regards,<br>Sunshine Dental Clinic</p>",
