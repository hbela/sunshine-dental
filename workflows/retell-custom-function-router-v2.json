    {
      "parameters": {
        "jsCode": "const args = $('Retell Webhook').first().json.body.args;\nconst date = args.date;\nconst providers = $input.all().map(item => item.json);\n\nif (!providers || providers.length === 0) {\n  return [{ json: { result: `I'm sorry, there are no doctors available on ${date}. Would you like to try a different date?` } }];\n}\n\nconst list = providers.map(p => `${p.provider_name} (${p.available_slots} slot${p.available_slots !== 1 ? 's' : ''})`).join(', ');\nconst firstDoctor = providers[0].provider_name;\n\nreturn [{ json: { result: `On ${date}, the following doctors are available: ${list}. Do you have a preference, or shall I book you with ${firstDoctor}?` } }];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Format Providers Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        1200
      ]
    },
