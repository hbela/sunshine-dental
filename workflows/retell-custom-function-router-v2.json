      "typeVersion": 2,
      "position": [
        1392,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const args = $('Retell Webhook').first().json.body.args;\nreturn [{ json: { result: `I couldn't find an appointment for ${args.patient_name} on ${args.date}. Could you double-check the name and date?` } }];"
      },
      "id": "6033062a-c72a-436a-8a02-866bfe7b3678",
      "name": "Format Cancel Not Found",
      "type": "n8n-nodes-base.code",
