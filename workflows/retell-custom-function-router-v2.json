    {
      "parameters": {
        "jsCode": "const args = $('Retell Webhook').first().json.body.args;\nif (args.callback_requested) {\n  return [{ json: { result: \"I've saved your information and requested a callback from our office staff. Someone will call you back as soon as possible. Is there anything else I can help with?\" } }];\n} else {\n  return [{ json: { result: \"I've saved your information in our records. Is there anything else I can help with?\" } }];\n}"
      },
