    {
      "parameters": {
        "jsCode": "const args = $json.body.args;\nconst topic = args.topic;\n\nconst faqData = {\n  office_hours: 'Our office hours are: Monday through Friday 8:00 AM to 5:00 PM, Saturday 9:00 AM to 1:00 PM. We are closed on Sundays. Please note we have a lunch break from 12:00 PM to 1:00 PM on weekdays.',\n  services: 'We offer: General Dentistry (cleanings, exams, fillings, crowns), Cosmetic Dentistry (teeth whitening, veneers, bonding), Orthodontics (braces, Invisalign), Oral Surgery (extractions, wisdom teeth removal), Pediatric Dentistry (children\\'s cleanings and sealants), and Emergency Dental Care (same-day appointments).',\n  insurance: 'We accept the following insurance providers: Delta Dental, Cigna, Aetna, MetLife, Guardian, and United Healthcare Dental. We also accept patients without insurance. Payment plans are available for procedures over $500. We accept cash, credit/debit cards, and CareCredit.',\n  emergency: 'For dental emergencies during office hours, call (555) 123-4567 and select option 2. For after-hours emergencies, call our emergency line at (555) 123-4568. For severe bleeding or jaw trauma, please go to the nearest emergency room immediately. If you have a knocked-out tooth, keep it moist in milk or saliva and come in right away.',\n  cancellation_policy: 'Please cancel or reschedule at least 24 hours in advance. Late cancellations may incur a $50 fee. No-shows may incur a $75 fee.',\n  new_patient_info: 'New patients should arrive 15 minutes early to fill out paperwork. Please bring your photo ID, insurance card, and a list of current medications. New patient forms are also available on our website at www.sunshinedentalclinic.com.',\n  location: 'We are located at 123 Main Street, Suite 100, Anytown, ST 12345. You can reach us by phone at (555) 123-4567 or by email at info@sunshinedentalclinic.com.',\n  payment_options: 'We accept cash, credit and debit cards, and CareCredit. Payment plans are available for procedures over $500. We also accept most major dental insurance plans.'\n};\n\nconst answer = faqData[topic] || 'I\\'m sorry, I don\\'t have information on that topic. Would you like me to have someone from the office call you back?';\n\nreturn [{ json: { result: answer } }];"
      },
